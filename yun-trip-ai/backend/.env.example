# ==================== 云途 AI 行程规划 - 环境配置文件 ====================
# 复制此文件为 .env 并填入真实值，.env 已被 .gitignore 排除，不会提交到仓库。

# -------------------- 大模型配置 --------------------
# 大模型提供商：openai_compatible 表示兼容 OpenAI 接口格式
LLM_PROVIDER=openai_compatible
# API Key，必填
LLM_API_KEY=your_api_key_here
# 模型名称，按服务商支持的模型填写
LLM_MODEL=qwen-max
# API 基础地址，阿里云 DashScope 使用此地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次请求超时时间（秒）
LLM_TIMEOUT_SECONDS=60
# 请求失败最大重试次数
LLM_MAX_RETRIES=1

# -------------------- RAG / 向量库配置 --------------------
# 向量库后端：chroma 或 milvus
VECTOR_STORE=chroma
# Chroma 持久化目录（相对 backend 目录）
CHROMA_DB_DIR=db/chroma_db
# Chroma collection 名称
CHROMA_COLLECTION_NAME=travel_guides
# Milvus Lite 持久化目录（相对 backend 目录）
MILVUS_DB_DIR=db/milvus_db
# Milvus collection 名称
MILVUS_COLLECTION_NAME=travel_guides
# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-v4
# Embedding 批处理大小
EMBEDDING_BATCH_SIZE=10
# Rerank 模型名称
RERANK_MODEL=qwen3-rerank

# -------------------- Redis / 缓存配置 --------------------
# 是否启用 Redis 缓存（true/false）
REDIS_ENABLED=false
# Redis 密码（需与 docker-compose 中 REDIS_PASSWORD 一致）
REDIS_PASSWORD=your-redis-password
# Redis 连接地址
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0
# 缓存 Key 前缀
REDIS_KEY_PREFIX=trip_planner
# 默认缓存过期时间（秒）
REDIS_DEFAULT_TTL_SECONDS=1800
# 天气缓存过期时间（秒）
REDIS_WEATHER_TTL_SECONDS=1800
# 地图缓存过期时间（秒）
REDIS_MAP_TTL_SECONDS=86400
# RAG 缓存过期时间（秒）
REDIS_RAG_TTL_SECONDS=21600
# Rerank 缓存过期时间（秒）
REDIS_RERANK_TTL_SECONDS=21600

# -------------------- 高德地图配置 --------------------
# 高德地图 Web API Key
AMAP_API_KEY=your_amap_api_key
# 高德地图 API 基础地址
AMAP_BASE_URL=https://restapi.amap.com/v3
# 默认城市（用于地理编码时补全）
AMAP_DEFAULT_CITY=
# 高德 API 请求超时（秒）
AMAP_TIMEOUT_SECONDS=20
# 是否启用高德地图数据补全（true/false）
ENABLE_AMAP_ENRICHMENT=false

# -------------------- 服务器配置 --------------------
# FastAPI 服务监听地址
SERVER_HOST=0.0.0.0
# FastAPI 服务监听端口
SERVER_PORT=8000
# 是否开启调试模式（true/false）
SERVER_DEBUG=false
# 允许的 CORS 来源（多个以逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:80,http://localhost

# -------------------- 日志配置 --------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志文件存放目录（相对 backend 目录）
LOG_DIR=logs
# 日志文件最大大小（MB），超过后自动轮转
LOG_MAX_SIZE_MB=10
# 日志文件保留天数
LOG_BACKUP_COUNT=7

# -------------------- JWT / 鉴权配置 --------------------
# JWT 签名密钥（生产环境务必更换为强随机字符串！）
JWT_SECRET_KEY=your-secret-key-change-in-production
# JWT 签名算法
JWT_ALGORITHM=HS256
# Token 过期时间（分钟），默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# -------------------- 接口限流配置 --------------------
# 全局接口每分钟最大请求数（0 表示不限流）
RATE_LIMIT_PER_MINUTE=60
# 行程生成接口每分钟最大请求数
RATE_LIMIT_GENERATE_PER_MINUTE=5
